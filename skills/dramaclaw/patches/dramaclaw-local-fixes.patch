旧加载器读 state/local/<project>/project_config.json，而注册表把项目
state_dir 指到 output/<project>，导致 sketch/render 的
image_generation_selection 缺失并回退到 LingShan-G2（NewAPI 503）。
load_project_config 现在叠加注册表 state_dir 的规范配置（只读查找，
缺失时行为不变）。
---
 src/novelvideo/project_config.py | 52 ++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/src/novelvideo/project_config.py b/src/novelvideo/project_config.py
index 8c424aeb..37312bd0 100644
--- a/src/novelvideo/project_config.py
+++ b/src/novelvideo/project_config.py
@@ -347,9 +347,61 @@ def save_project_config_in_state_dir(
     return update_project_config_file_in_state_dir(state_dir, _apply)
 
 
+def _registry_state_dir_for(username: str, project: str) -> str | None:
+    """Return the registry state_dir for a local project, if one is recorded.
+
+    The registry (STATE_DIR/local/projects.db) is canonical for where a
+    project's live data lives. Several legacy call sites still resolve the
+    project config through ``state/local/<project>/project_config.json`` even
+    though the registry may point ``state_dir`` at ``output/<project>``. This
+    read-only lookup lets ``load_project_config`` overlay the canonical config
+    without touching the legacy file.
+    """
+    import sqlite3
+
+    from novelvideo import config as _config
+
+    db_path = Path(_config.STATE_DIR) / "local" / "projects.db"
+    if not db_path.exists():
+        return None
+    try:
+        con = sqlite3.connect(f"file:{db_path.as_posix()}?mode=ro", uri=True)
+        try:
+            row = con.execute(
+                "SELECT state_dir FROM projects "
+                "WHERE owner_username = ? AND name = ? LIMIT 1",
+                (username, project),
+            ).fetchone()
+        finally:
+            con.close()
+    except Exception:  # pragma: no cover - registry is best-effort
+        return None
+    return str(row[0]) if row and row[0] else None
+
+
+def _overlay_registry_state_dir_config(username: str, project: str, config: dict) -> dict:
+    """Overlay the registry state_dir config onto a legacy config load.
+
+    The state_dir copy is canonical: image selections, visual style, narration
+    settings, and embedding bindings must follow the project the registry
+    actually points at. Keys missing from the canonical copy keep their legacy
+    values (e.g. narrator audio), so the merge is strictly additive.
+    """
+    state_dir = _registry_state_dir_for(username, project)
+    if not state_dir:
+        return config
+    canonical = load_project_config_file_from_state_dir(state_dir)
+    if not canonical:
+        return config
+    merged = dict(config)
+    merged.update(canonical)
+    return merged
+
+
 def load_project_config(username: str, project: str) -> dict:
     """Load project configuration with runtime defaults applied."""
     config = load_project_config_file(username, project)
+    config = _overlay_registry_state_dir_config(username, project, config)
 
     project_uuid = str(config.get("project_uuid", "") or "").strip()
     if config and not project_uuid:
