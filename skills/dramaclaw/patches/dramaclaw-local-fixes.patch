+def _ffmpeg_binary() -> str:
+    configured = os.environ.get("FFMPEG_PATH", "").strip()
+    if configured and Path(configured).exists():
+        return configured
+    discovered = shutil.which("ffmpeg")
+    if discovered:
+        return discovered
+    runtime_root = Path(__file__).resolve().parents[2] / "runtime" / "ffmpeg"
+    candidates = sorted(runtime_root.rglob("ffmpeg.exe"))
+    return str(candidates[0]) if candidates else "ffmpeg"
+
