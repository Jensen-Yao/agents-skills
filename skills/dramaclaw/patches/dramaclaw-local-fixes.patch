+def _replace_with_retry(src: Path, dst: Path, attempts: int = 15, delay: float = 0.5) -> None:
+    """Rename with retries to absorb transient Windows file locks.
+
+    Freshly written PNGs can be held briefly by antivirus scanners or by a
+    concurrent splitter pass (WinError 32). Retrying instead of failing keeps
+    the whole inline task runner alive.
+    """
+    for attempt in range(attempts):
+        try:
+            src.replace(dst)
+            return
+        except PermissionError:
+            if attempt >= attempts - 1:
+                raise
+            time.sleep(delay)
+
+
+def _copy2_with_retry(src: str, dst: str, attempts: int = 15, delay: float = 0.5) -> None:
+    for attempt in range(attempts):
+        try:
+            shutil.copy2(src, dst)
+            return
+        except PermissionError:
+            if attempt >= attempts - 1:
+                raise
+            time.sleep(delay)
+
