本地 NewAPI 没有音频模型渠道，/audio/generate 必然 503。IndexTTS2FalClient
在 newapi 分支失败且错误含 404/503/not found/channel 时，用 Edge TTS
中文男声合成旁白/对白，保证主线音频阶段可用。
---
 src/novelvideo/generators/indextts2_fal.py | 54 ++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/src/novelvideo/generators/indextts2_fal.py b/src/novelvideo/generators/indextts2_fal.py
index 3059c2d4..d58e36bf 100644
--- a/src/novelvideo/generators/indextts2_fal.py
+++ b/src/novelvideo/generators/indextts2_fal.py
@@ -71,6 +71,22 @@ def _extract_audio_url(payload: dict[str, Any]) -> str:
     return ""
 
 
+def _looks_like_model_unavailable(error: str | None) -> bool:
+    text = str(error or "").lower()
+    return any(
+        marker in text
+        for marker in (
+            "404",
+            "503",
+            "not found",
+            "model_not_found",
+            "no available",
+            "channel",
+            "unsupported model",
+        )
+    )
+
+
 async def _audio_duration_seconds(audio_path: Path) -> float:
     try:
         result = subprocess.run(
@@ -178,6 +194,11 @@ class IndexTTS2FalClient:
                 output_path=target,
                 emotion_prompt=emotion_prompt,
             )
+            if not result.success and _looks_like_model_unavailable(result.error):
+                result = await self._generate_via_edge_fallback(
+                    prompt=prompt,
+                    output_path=target,
+                )
         else:
             result = await self._generate_via_fal(
                 prompt=prompt,
@@ -201,6 +222,39 @@ class IndexTTS2FalClient:
             )
         return result
 
+    async def _generate_via_edge_fallback(
+        self,
+        *,
+        prompt: str,
+        output_path: Path,
+    ) -> TTSResult:
+        """Edge TTS fallback when NewAPI has no IndexTTS2 channel.
+
+        Edge TTS cannot clone the narrator reference voice, so the narration is
+        synthesized with a mature Mandarin male preset. This keeps the mainline
+        audio stage functional without an IndexTTS2-capable upstream channel.
+        """
+        import edge_tts
+
+        last_error = ""
+        for voice in ("zh-CN-YunjianNeural", "zh-CN-YunxiNeural"):
+            try:
+                communicate = edge_tts.Communicate(prompt, voice)
+                await communicate.save(str(output_path))
+            except Exception as exc:  # pragma: no cover - network dependent
+                last_error = f"{exc.__class__.__name__}: {exc}"
+                continue
+            if output_path.exists() and output_path.stat().st_size > 0:
+                return TTSResult(
+                    success=True,
+                    audio_path=str(output_path),
+                    duration_seconds=await _audio_duration_seconds(output_path),
+                )
+        return TTSResult(
+            success=False,
+            error=f"edge-tts fallback failed: {last_error or 'no output file'}",
+        )
+
     async def _generate_via_fal(
         self,
         *,
