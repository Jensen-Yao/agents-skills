启动 DramaClaw.cmd 原为 UTF-8，cmd.exe 按 GBK 解析导致 NewAPI 自动拉起
判断失效；重写为 GBK(936) 并加 netstat 端口检查，避免重复启动 API。
启动 NewAPI.cmd 为纯 ASCII 脚本，一并入库保留。
---
 "\345\220\257\345\212\250 DramaClaw.cmd" | 30 ++++++++++++++++++++++++
 "\345\220\257\345\212\250 NewAPI.cmd"    | 25 ++++++++++++++++++++
 2 files changed, 55 insertions(+)
 create mode 100644 "\345\220\257\345\212\250 DramaClaw.cmd"
 create mode 100644 "\345\220\257\345\212\250 NewAPI.cmd"

diff --git "a/\345\220\257\345\212\250 DramaClaw.cmd" "b/\345\220\257\345\212\250 DramaClaw.cmd"
new file mode 100644
index 00000000..eba805ab
--- /dev/null
+++ "b/\345\220\257\345\212\250 DramaClaw.cmd"	
@@ -0,0 +1,30 @@
+@echo off
+setlocal
+
+set "ROOT=F:\DramaClaw"
+set "API_PORT=8780"
+set "WEB_PORT=5174"
+
+if not exist "%ROOT%\.venv\Scripts\novelvideo.exe" (
+  echo Missing Python environment: %ROOT%\.venv
+  pause
+  exit /b 1
+)
+
+if not exist "%ROOT%\frontend\node_modules\.bin\vite.cmd" (
+  echo Missing frontend dependencies: %ROOT%\frontend\node_modules
+  pause
+  exit /b 1
+)
+
+if exist "%ROOT%\��� NewAPI.cmd" call "%ROOT%\��� NewAPI.cmd"
+
+netstat -ano | findstr /r ":%API_PORT% .*LISTENING" >nul 2>&1
+if errorlevel 1 start "DramaClaw API" /D "%ROOT%" "%ROOT%\.venv\Scripts\novelvideo.exe" api --host 127.0.0.1 --port %API_PORT%
+
+start "DramaClaw Web" /D "%ROOT%\frontend" cmd /c "node_modules\.bin\vite.cmd --host 127.0.0.1 --port %WEB_PORT% --mode ce"
+
+timeout /t 3 /nobreak >nul
+start "" "http://127.0.0.1:%WEB_PORT%/"
+
+endlocal
\ No newline at end of file
diff --git "a/\345\220\257\345\212\250 NewAPI.cmd" "b/\345\220\257\345\212\250 NewAPI.cmd"
new file mode 100644
index 00000000..c1d999f2
--- /dev/null
+++ "b/\345\220\257\345\212\250 NewAPI.cmd"	
@@ -0,0 +1,25 @@
+@echo off
+setlocal
+
+set "ROOT=%~dp0"
+set "EXE=%ROOT%runtime\new-api.exe"
+set "WORK=%ROOT%state\newapi"
+set "SECRET=%ROOT%runtime\newapi.secret"
+
+if not exist "%EXE%" (
+  echo [ERROR] new-api.exe not found: %EXE%
+  pause
+  exit /b 1
+)
+
+if not exist "%WORK%" mkdir "%WORK%"
+if not exist "%SECRET%" powershell -NoProfile -Command "[guid]::NewGuid().ToString('N')" > "%SECRET%"
+
+powershell -NoProfile -ExecutionPolicy Bypass -Command ^
+  "$env:SQL_DSN='';" ^
+  "$env:TZ='Asia/Shanghai';" ^
+  "$env:SESSION_SECRET=(Get-Content '%SECRET%').Trim();" ^
+  "$existing = Get-Process -Name 'new-api' -ErrorAction SilentlyContinue;" ^
+  "if ($existing) { Write-Output ('NewAPI already running: PID ' + $existing.Id) } else { $p = Start-Process -FilePath '%EXE%' -WorkingDirectory '%WORK%' -WindowStyle Hidden -PassThru; $p.Id | Out-File -FilePath '%ROOT%runtime\newapi.pid' -Encoding ascii; Write-Output ('NewAPI started: PID ' + $p.Id) }"
+
+endlocal
