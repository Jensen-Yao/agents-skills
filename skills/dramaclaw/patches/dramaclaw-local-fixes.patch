+async def _mux_video_with_narration(
+    video_path: str,
+    audio_path: str,
+    output_path: str,
+) -> None:
+    """Loop a short Agnes motion clip under the full narration track."""
+    cmd = [
+        _ffmpeg_binary(),
+        "-y",
+        "-stream_loop",
+        "-1",
+        "-i",
+        video_path,
+        "-i",
+        audio_path,
+        "-map",
+        "0:v:0",
+        "-map",
+        "1:a:0",
+        "-c:v",
+        "copy",
+        "-c:a",
+        "aac",
+        "-ar",
+        "48000",
+        "-ac",
+        "2",
+        "-shortest",
+        output_path,
+    ]
+    result = await asyncio.to_thread(
+        subprocess.run,
+        cmd,
+        capture_output=True,
+        text=True,
+        timeout=30 * 60,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr[-1200:] or "ffmpeg narration mux failed")
+
+
+async def _make_silent_audio(output_path: str, duration_seconds: float = 5.0) -> None:
+    """Create a short silent AAC-compatible track when TTS is unavailable."""
+    cmd = [
+        _ffmpeg_binary(),
+        "-y",
+        "-f",
+        "lavfi",
+        "-i",
+        "anullsrc=channel_layout=stereo:sample_rate=48000",
+        "-t",
+        str(max(duration_seconds, 1.0)),
+        "-c:a",
+        "aac",
+        "-b:a",
+        "128k",
+        output_path,
+    ]
+    result = await asyncio.to_thread(
+        subprocess.run,
+        cmd,
+        capture_output=True,
+        text=True,
+        timeout=120,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr[-1200:] or "ffmpeg silent audio failed")
+
+
+async def _concat_direct_videos(video_paths: list[str], output_path: str) -> None:
+    list_path = ""
+    try:
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False, encoding="utf-8") as handle:
+            list_path = handle.name
+            for path in video_paths:
+                handle.write(f"file '{Path(path).resolve().as_posix()}'\n")
+        result = await asyncio.to_thread(
