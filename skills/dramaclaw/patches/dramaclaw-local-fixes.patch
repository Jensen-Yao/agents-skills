@@ -204,6 +204,146 @@ def _beat_display_sort_key(beat: dict) -> tuple[int, int]:
     return (beat_order_value(beat), int(beat.get("beat_number", 0) or 0))
 
 
+def _agnes_single_panel_sketch_prompt(
+    beats: list[dict],
+    *,
+    sketch_colors: dict[str, str] | None,
+    prop_marker_colors: dict[str, str] | None,
+) -> str:
+    """Compact single-frame sketch prompt for Agnes image models.
+
+    Agnes image-2.1-flash is strongly biased toward multi-panel storyboard
+    sheets whenever it sees storyboard/grid vocabulary, so 1x1 sketch requests
+    get a minimal single-image prompt instead of the full storyboard brief.
+    """
+    beat = (beats or [{}])[0]
+    visual = str(beat.get("visual_description") or beat.get("narration") or "").strip()
+    if not visual:
+        visual = "a single dramatic composition"
+    try:
+        scene_ref = json.loads(str(beat.get("scene_ref_json") or "{}"))
+        scene_name = str(scene_ref.get("scene_id") or "").strip()
+    except Exception:
+        scene_name = ""
+    identity_ids = [str(i) for i in (beat.get("detected_identities") or []) if str(i).strip()]
+    prop_ids = [str(p) for p in (beat.get("detected_props") or []) if str(p).strip()]
+    color_map: dict[str, str] = {}
+    for key, value in (sketch_colors or {}).items():
+        if key and value:
+            color_map[str(key)] = str(value)
+    for key, value in (prop_marker_colors or {}).items():
+        if key and value:
+            color_map[str(key)] = str(value)
+
+    def color_for(key: str) -> str:
+        value = str(color_map.get(key) or "").strip()
+        return value if value else "gray"
+
+    char_lines = []
+    for ident in identity_ids:
+        if ident.startswith("__"):
+            continue
+        name = ident.rsplit("_", 1)[0]
+        char_lines.append(
+            f"{name} is ONE flat {color_for(ident)} stick-mannequin "
+            "(oval head, no face, no clothing detail)"
+        )
+    prop_lines = []
+    for prop in prop_ids:
+        if prop.startswith("__"):
+            continue
+        prop_lines.append(
+            f"{prop} is ONE flat {color_for(prop)} solid silhouette with zero internal detail"
+        )
+    scene_line = (
+        f"Background is a very simple black/gray line-art version of the scene {scene_name}"
+        if scene_name
+        else "Background is very simple black/gray line art"
+    )
+    parts = [
+        "ONE single rough anime blocking sketch. EXACTLY ONE image, one single frame, 2:3 portrait.",
+        "NO grid, NO multiple panels, NO comic strip, NO storyboard sheet, NO collage, "
+        "NO before/after, NO split screen, NO panel-within-panel.",
+        "NO text, NO captions, NO labels, NO numbers, NO letters anywhere in the image.",
+        "Pure white paper background.",
+        scene_line + ".",
+        ("Characters: " + "; ".join(char_lines) + ".") if char_lines else "No characters.",
+        ("Props: " + "; ".join(prop_lines) + ".") if prop_lines else "No props.",
+        f"Composition (ONE frozen moment only): {visual}",
+        "Rough loose pencil sketch style, unfinished draft look, minimal detail.",
+    ]
+    return "\n".join(parts)
+
+
+def _agnes_single_panel_render_prompt(
+    beats: list[dict],
+    *,
+    character_map: dict | None,
+    scene_menu: list[dict] | list | None,
+) -> str:
+    """Compact single-frame render prompt for Agnes image models.
+
+    Agnes image-2.1-flash drifts into multi-panel storyboard output when it
+    receives the full render brief (or any attached reference collage), so 1x1
+    render requests get a minimal single-image prompt and no reference images.
+    Identity consistency comes from the written appearance text.
+    """
+    beat = (beats or [{}])[0]
+    visual = str(beat.get("visual_description") or beat.get("narration") or "").strip()
+    if not visual:
+        visual = "a single dramatic composition"
+    try:
+        scene_ref = json.loads(str(beat.get("scene_ref_json") or "{}"))
+        scene_name = str(scene_ref.get("scene_id") or "").strip()
+    except Exception:
+        scene_name = ""
+    env_hint = ""
+    for item in list(scene_menu or []):
+        if not isinstance(item, dict):
+            continue
+        if str(item.get("scene_id") or "") == scene_name:
+            env_hint = str(item.get("environment_prompt") or "").strip()
+            break
+    if env_hint and len(env_hint) > 260:
+        env_hint = env_hint[:260].rstrip("，。; ") + "。"
+
+    identity_ids = [str(i) for i in (beat.get("detected_identities") or []) if str(i).strip()]
+    char_lines = []
+    cmap = character_map or {}
+    for ident in identity_ids:
+        if ident.startswith("__"):
+            continue
+        info = cmap.get(ident) or cmap.get(ident.rsplit("_", 1)[0]) or {}
+        appearance = (
+            str(info.get("appearance_details") or "")
+            or str(info.get("base_prompt") or "")
+            or ""
+        )
+        identity_appearances = info.get("identity_appearances") or {}
+        if not appearance and isinstance(identity_appearances, dict):
+            appearance = str(identity_appearances.get(ident.rsplit("_", 1)[-1]) or "")
+        char_lines.append(
+            f"{ident.rsplit('_', 1)[0]} ({ident.rsplit('_', 1)[-1]}): {appearance or 'consistent anime character'}"
+        )
+    prop_ids = [str(p) for p in (beat.get("detected_props") or []) if str(p).strip() and not str(p).startswith("__")]
+
+    parts = [
+        "ONE single anime illustration frame. EXACTLY ONE image, 2:3 portrait, one camera shot.",
+        "NO grid, NO panels, NO comic strip, NO collage, NO split screen, NO before/after.",
+        "NO text, NO captions, NO letters, NO watermark anywhere in the image.",
+        "Style: 2D Japanese anime cel shading, clean line art, muted retro color palette, "
+        "high-quality film still.",
+        f"Scene: {scene_name}." + (f" Environment: {env_hint}" if env_hint else ""),
+        ("Characters (draw exactly these, consistent faces):\n- " + "\n- ".join(char_lines) + ".")
+        if char_lines
+        else "No characters in frame.",
+        f"Props present: {', '.join(prop_ids)}." if prop_ids else "No props.",
+        f"Composition (ONE frozen moment only): {visual}",
+        "The whole canvas is one single continuous image with a single subject composition.",
+    ]
+    return "\n".join(parts)
+
