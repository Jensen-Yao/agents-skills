+                "-i",
+                list_path,
+                "-c",
+                "copy",
+                output_path,
+            ],
+            capture_output=True,
+            text=True,
+            timeout=30 * 60,
+        )
+        if result.returncode != 0:
+            raise RuntimeError(result.stderr[-1200:] or "ffmpeg video concat failed")
